# ==============================================================================
# VeriSight MCP — Environment Configuration Template
# For OpenCV AI Competition 2026 (Powered by AWS)
#
# NOTE: DO NOT commit your actual .env file with real credentials to GitHub!
# This project includes automated zero-config local fallback if AWS keys are omitted.
# ==============================================================================

# AWS Configuration (Optional for local testing; required for live AWS S3/DynamoDB)
# When running on an AWS EC2 Graviton instance with an attached IAM Role,
# credentials are automatically resolved via instance metadata (IMDSv2).
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Amazon S3 Evidence Vault
AWS_S3_BUCKET=verisight-forensics-evidence

# Amazon DynamoDB Immutable Audit Table
AWS_DYNAMODB_TABLE=VeriSightAuditLedger

# FastAPI & Next.js Service Endpoints
PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
